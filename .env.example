APP_NAME="MeeTea&Poke"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=meeteapoke
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Numero WhatsApp del negozio con prefisso, es. 393331234567
WHATSAPP_NUMBER=
# Apikey ricevuta da Callmebot dopo l'attivazione
WHATSAPP_APIKEY=

# Password per accedere al pannello /admin
ADMIN_PASSWORD=
# Token bearer usato dal frontend admin dopo login (stringa lunga random)
ADMIN_TOKEN=

VITE_APP_NAME="${APP_NAME}"
