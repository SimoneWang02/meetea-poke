<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MeeTea &amp; Poke"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configurazione Stampante"
            android:textSize="14sp"
            android:textColor="#888888"
            android:layout_marginBottom="32dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="URL base API"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="es. https://meetea-poke.com"
            android:inputType="textUri"
            android:padding="14dp"
            android:background="@drawable/input_bg"
            android:textSize="15sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bearer Token (PRINT_API_TOKEN)"
            android:textSize="14sp"
            android:textColor="#444444"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/editToken"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Token dal file .env"
            android:inputType="textPassword"
            android:padding="14dp"
            android:background="@drawable/input_bg"
            android:textSize="15sp"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Salva e avvia stampa"
            android:textSize="16sp"
            android:backgroundTint="#2D6A4F"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
