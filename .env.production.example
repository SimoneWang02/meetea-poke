APP_NAME="MeeTea&Poke"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://meetea-poke.com

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=meeteapoke
DB_USERNAME=meeteapoke
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_ROOT_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@meetea-poke.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_PASSWORD=CHANGE_ME
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

# Token bearer per l'APK Android stampante Sunmi
PRINT_API_TOKEN=CHANGE_ME_LONG_RANDOM_STRING

VITE_APP_NAME="${APP_NAME}"
